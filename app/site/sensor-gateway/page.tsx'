  const handleCommissionSignoff = async (roleType: "ARCHITECT" | "SUPERINTENDENT") => {
    if (!selectedDevice || !isArchitectOrSuperintendent) return;
    setActionInProgress(`commission_${roleType}`);

    const isArch = roleType === "ARCHITECT";
    const updatePayload: Partial<SensorHardwareRecord> = {
      architect_signoff: isArch ? true : selectedDevice.architect_signoff,
      superintendent_signoff: !isArch ? true : selectedDevice.superintendent_signoff,
      connection_status: "ONLINE",
    };

    // Both signed off unlocks full commissioning
    if ((isArch && selectedDevice.superintendent_signoff) || (!isArch && selectedDevice.architect_signoff)) {
      updatePayload.commissioned_by = roleLabel || "Site Authority";
      updatePayload.commissioned_at = new Date().toISOString();
    }

    try {
      await (supabase as any)
        .from("site_sensor_hardware")
        .update(updatePayload)
        .eq("id", selectedDevice.id);
    } catch {
      // Local optimistic update
    }

    setDevices((prev) =>
      prev.map((d) => (d.id === selectedDevice.id ? ({ ...d, ...updatePayload } as SensorHardwareRecord) : d))
    );
    setSelectedDevice((prev) => (prev ? ({ ...prev, ...updatePayload } as SensorHardwareRecord) : null));

    setFeedbackMessage(
      `${isArch ? "Principal Architect" : "Site Superintendent"} calibrated and signed off ${selectedDevice.device_code}.`
    );
    setTimeout(() => setFeedbackMessage(null), 3500);
    setActionInProgress(null);
  };

