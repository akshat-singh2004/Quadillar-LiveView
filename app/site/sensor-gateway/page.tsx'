    setActionInProgress(`ping_${dev.id}`);

    // Simulated network ping
    await new Promise((r) => setTimeout(r, 600));
    const simulatedLatency = Math.floor(12 + Math.random() * 20);

    const updatePayload = {
      connection_status: "ONLINE" as const,
      latency_ms: simulatedLatency,
      last_handshake_at: new Date().toISOString(),
    };

    try {
      await (supabase as any)
        .from("site_sensor_hardware")
        .update(updatePayload)
        .eq("id", dev.id);
    } catch {
      // Local optimistic update
    }

    setDevices((prev) =>
      prev.map((d) => (d.id === dev.id ? { ...d, ...updatePayload } : d))
    );
    if (selectedDevice && selectedDevice.id === dev.id) {
      setSelectedDevice((prev) => (prev ? { ...prev, ...updatePayload } : null));
    }

    setFeedbackMessage(`Hardware handshake successful for ${dev.device_code} (${simulatedLatency}ms latency).`);
    setTimeout(() => setFeedbackMessage(null), 3500);
    setActionInProgress(null);
  };

