      device_name: devName.trim(),
      device_type: devType,
      manufacturer_model: model.trim(),
      ip_address_or_endpoint: ipEndpoint.trim(),
      rtsp_stream_url: streamUrl.trim() || null,
      viewing_window_id: windowId.trim(),
      location_grid: grid.trim(),
      mounting_elevation_m: Number(elevation),
      fov_azimuth_degrees: Number(azimuth),
      ai_detection_profile: aiProfile.trim(),
      connection_status: "PENDING_COMMISSIONING",
      latency_ms: 0,
      architect_signoff: false,
      superintendent_signoff: false,
    };

    try {
      const { data, error } = await (supabase as any)
        .from("site_sensor_hardware")
        .insert([newDbRecord])
        .select()
        .single();

      if (data) {
        const normalized = normalizeHardwareRecord(data);
        setDevices((prev) => [normalized, ...prev]);
        setSelectedDevice(normalized);
      } else {
        throw error;
      }
