export type SensorDeviceType =
  | "PTZ_CAMERA"
  | "FIXED_BULLET_CAMERA"
  | "AUTONOMOUS_DRONE_DOCK"
  | "LIDAR_BASE_STATION"
  | "ENVIRONMENTAL_WEATHER_IOT";

export type HardwareConnectionState =
  | "ONLINE"
  | "OFFLINE"
  | "FAILED_HANDSHAKE"
  | "PENDING_COMMISSIONING"
  | "CALIBRATION_REQUIRED";

export interface SensorHardwareRecord {
  id: string;
  project_id: string;
  device_code: string;
  device_name: string;
  device_type: SensorDeviceType;
  manufacturer_model: string;
  ip_address_or_endpoint: string;
  rtsp_stream_url?: string | null;
  viewing_window_id: string;
  location_grid: string;
  mounting_elevation_m: number;
  fov_azimuth_degrees: number;
  ai_detection_profile: string;
  connection_status: HardwareConnectionState;
  latency_ms: number;
  last_handshake_at?: string | null;
  architect_signoff: boolean;
  superintendent_signoff: boolean;
  commissioned_by?: string | null;
  commissioned_at?: string | null;
  calibration_notes?: string | null;
  created_at?: string;
}

function normalizeHardwareRecord(d: any): SensorHardwareRecord {
  return {
    id: d?.id ?? `hw-${Date.now()}`,
    project_id: d?.project_id ?? "proj-default",
    device_code: d?.device_code ?? `DEV-${Date.now().toString().slice(-4)}`,
    device_name: d?.device_name ?? "Surveillance Sensor Node",
    device_type: (d?.device_type as SensorDeviceType) ?? "PTZ_CAMERA",
    manufacturer_model: d?.manufacturer_model ?? "Hikvision 4K Ultra PTZ",
    ip_address_or_endpoint: d?.ip_address_or_endpoint ?? "192.168.1.100",
    rtsp_stream_url: d?.rtsp_stream_url ?? null,
    viewing_window_id: d?.viewing_window_id ?? "VIEWPORT_DEFAULT",
    location_grid: d?.location_grid ?? "Site Grid",
    mounting_elevation_m: Number(d?.mounting_elevation_m ?? 0),
    fov_azimuth_degrees: Number(d?.fov_azimuth_degrees ?? 0),
    ai_detection_profile: d?.ai_detection_profile ?? "PPE_AND_EXCLUSION_ZONE",
    connection_status: (d?.connection_status as HardwareConnectionState) ?? "PENDING_COMMISSIONING",
    latency_ms: Number(d?.latency_ms ?? 0),
    last_handshake_at: d?.last_handshake_at ?? null,
    architect_signoff: Boolean(d?.architect_signoff),
    superintendent_signoff: Boolean(d?.superintendent_signoff),
    commissioned_by: d?.commissioned_by ?? null,
    commissioned_at: d?.commissioned_at ?? null,
    calibration_notes: d?.calibration_notes ?? null,
    created_at: d?.created_at ?? new Date().toISOString(),
  };
}

